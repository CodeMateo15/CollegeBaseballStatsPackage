    "rules": {
      "class": "class_ord >= 3, i.e. Junior or Senior. This is the primary rule and covers 31,494 player-seasons.",
      "drafted": "was drafted out of this season -- proof after the fact, not a test",
      "early-or-ineligible": "an underclassman in their first or second season. Some are genuinely eligible on the age-21 route and cannot be identified as such here.",
      "tenure": "seasons_elapsed >= 2, i.e. a third season or later counted from the player's first appearance. Adds 451 rows that class standing alone misses -- sophomores and freshmen who redshirted or transferred in, and so are further through their eligibility than their class year says.",
